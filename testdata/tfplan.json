{
  "resource_changes": [
    {
      "address": "aws_eks_cluster.main",
      "type": "aws_eks_cluster",
      "name": "main",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "conftest-book-dev",
          "version": "1.30",
          "vpc_config": [
            {
              "endpoint_private_access": true,
              "endpoint_public_access": false
            }
          ],
          "encryption_config": [
            {
              "resources": ["secrets"]
            }
          ]
        }
      }
    },
    {
      "address": "aws_eks_node_group.default",
      "type": "aws_eks_node_group",
      "name": "default",
      "change": {
        "actions": ["create"],
        "after": {
          "node_group_name": "conftest-book-dev-default",
          "instance_types": ["t4g.medium"],
          "scaling_config": [
            {
              "desired_size": 2,
              "min_size": 1,
              "max_size": 3
            }
          ]
        }
      }
    }
  ]
}
